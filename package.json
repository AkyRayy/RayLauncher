{
  "name": "raylauncher",
  "version": "1.0.0",
  "description": "Лаунчер Minecraft Java Edition для Windows на Electron 44 и React 19",
  "keywords": [
    "minecraft",
    "launcher",
    "electron",
    "react",
    "typescript",
    "windows"
  ],
  "author": "RayLauncher",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AkyRayy/RayLauncher.git"
  },
  "bugs": {
    "url": "https://github.com/AkyRayy/RayLauncher/issues"
  },
  "homepage": "https://github.com/AkyRayy/RayLauncher#readme",
  "private": false,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win --x64 --arm64",
    "rebuild": "electron-rebuild",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "framer-motion": "13.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "sanitize-html": "^2.17.7",
    "skinview3d": "^3.4.1",
    "yauzl": "^3.4.0",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.1",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
